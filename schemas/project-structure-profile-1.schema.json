{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MNCDS declared project structure profile (experimental)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "required_paths",
    "artifact_classes",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "const": "mncds.project-structure-profile/1"
    },
    "profile": {
      "type": "string"
    },
    "required_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifact_classes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "authoritative",
          "derived",
          "mixed",
          "interpretation"
        ]
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
